@model TaskTrackerProject.Models.SignUp

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f4f6f9;
    }

    .page-title {
        font-weight: 600;
        color: #2c3345;
        margin-bottom: 1.5rem;
    }

    .app-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
    }

    .app-card .card-header {
        border: none;
        padding: 1.1rem 1.5rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .card-header-gradient {
        background: linear-gradient(135deg, #4e73df, #364fc7);
        color: #fff;
    }

    .card-header-dark {
        background: #2c3345;
        color: #fff;
    }

    .card-body {
        padding: 1.75rem;
    }

    .form-label {
        font-weight: 500;
        color: #444;
        margin-bottom: 0.35rem;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #dcdfe6;
        padding: 0.55rem 0.8rem;
    }

    .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.15);
    }

    .btn {
        border-radius: 8px;
        font-weight: 500;
        padding: 0.5rem 1.4rem;
    }

    .btn-success {
        background-color: #2e9e4f;
        border-color: #2e9e4f;
    }

    .btn-success:hover {
        background-color: #26833f;
        border-color: #26833f;
    }

    .btn-secondary {
        background-color: #e9ecef;
        border-color: #e9ecef;
        color: #333;
    }

    .btn-secondary:hover {
        background-color: #dde1e5;
        color: #333;
    }

    .table thead th {
        background-color: #f1f3f9;
        color: #2c3345;
        font-weight: 600;
        border-bottom: 2px solid #e2e5ec;
        white-space: nowrap;
    }

    .table td,
    .table th {
        vertical-align: middle;
        padding: 0.85rem 0.9rem;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fc;
    }

    .btn-action {
        border-radius: 6px;
        padding: 0.3rem 0.7rem;
        font-size: 0.85rem;
    }

    .empty-row {
        text-align: center;
        color: #888;
        padding: 2rem 0;
    }
</style>

<div class="container mt-5 mb-5">

    <h2 class="page-title"><i class="bi bi-person-lines-fill me-2"></i>User Registration</h2>

    <!-- Hidden Id -->
    <input type="hidden" id="txtId" />

    <!-- Sign Up Form -->
    <div class="card app-card">

        <div class="card-header card-header-gradient">
            <i class="bi bi-person-plus-fill me-2"></i>Sign Up
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" id="txtName" class="form-control" placeholder="Enter full name" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" id="txtEmail" class="form-control" placeholder="Enter email address" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" id="txtPhone" class="form-control" placeholder="Enter phone number" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Date of Birth</label>
                    <input type="date" id="txtDOB" class="form-control" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Address</label>
                    <textarea id="txtAddress" class="form-control" rows="3" placeholder="Enter address"></textarea>
                </div>

            </div>

            <div class="d-flex gap-2 mt-2">

                <button id="btnSave" class="btn btn-success" onclick="saveData()">
                    <i class="bi bi-check-circle me-1"></i>Sign Up
                </button>

                <button class="btn btn-secondary" onclick="clearForm()">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </button>

            </div>

        </div>

    </div>

    <!-- User List -->
    <div class="card app-card mt-4">

        <div class="card-header card-header-dark">
            <i class="bi bi-people-fill me-2"></i>Registered Users
        </div>

        <div class="card-body table-responsive p-0">

            <table class="table table-bordered table-striped table-hover mb-0" id="tblData">

                <thead>

                    <tr>
                        <th>SN</th>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>DOB</th>
                        <th width="170">Action</th>
                    </tr>

                </thead>

                <tbody></tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            getData();

        });

        function validate() {

            if ($("#txtName").val() == "") {
                alert("Name is required");
                return false;
            }

            if ($("#txtAddress").val() == "") {
                alert("Address is required");
                return false;
            }

            if ($("#txtEmail").val() == "") {
                alert("Email is required");
                return false;
            }

            if ($("#txtPhone").val() == "") {
                alert("Phone is required");
                return false;
            }

            if ($("#txtDOB").val() == "") {
                alert("DOB is required");
                return false;
            }

            return true;
        }

        function saveData() {

            if (!validate())
                return;

            var model = {

                Id: $("#txtId").val(),
                Name: $("#txtName").val(),
                Address: $("#txtAddress").val(),
                Email: $("#txtEmail").val(),
                Phone: $("#txtPhone").val(),
                DOB: $("#txtDOB").val()

            };

            if ($("#txtId").val() == "") {

                // Save

                fetch('/api/signup/save', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(model)

                })
                    .then(response => response.json())
                    .then(data => {

                        if (data.success) {

                            alert("Registration Successful");

                            clearForm();

                            getData();

                        }
                        else {

                            alert(data.message);

                        }

                    });

            }
            else {

                // Update

                fetch('/api/signup/update', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(model)

                })
                    .then(response => response.json())
                    .then(data => {

                        if (data.status) {

                            alert(data.message);

                            clearForm();

                            getData();

                        }
                        else {

                            alert(data.message);

                        }

                    });

            }

        }

        function getData() {

            fetch('/api/signup/get', {

                method: 'GET',

                headers: {
                    'Content-Type': 'application/json'
                }

            })
                .then(response => response.json())
                .then(data => {

                    $("#tblData tbody").empty();

                    if (data.status) {

                        $.each(data.data, function (index, item) {

                            var dob = "";

                            if (item.dob != null) {

                                dob = item.dob.substring(0, 10);

                            }

                            $("#tblData tbody").append(

                                "<tr>" +
                                "<td>" + (index + 1) + "</td>" +
                                "<td>" + item.name + "</td>" +
                                "<td>" + item.address + "</td>" +
                                "<td>" + item.email + "</td>" +
                                "<td>" + item.phone + "</td>" +
                                "<td>" + dob + "</td>" +
                                "<td>" +
                                "<button class='btn btn-warning btn-sm btn-action me-1' onclick='editData(\"" + item.id + "\")'><i class=\"bi bi-pencil-square\"></i> Edit</button>" +
                                "<button class='btn btn-danger btn-sm btn-action' onclick='deleteData(\"" + item.id + "\")'><i class=\"bi bi-trash3\"></i> Delete</button>" +
                                "</td>" +
                                "</tr>"

                            );

                        });

                    }
                    else {

                        alert(data.message);

                    }

                });

        }

        function editData(id) {

            fetch('/api/signup/get')
                .then(response => response.json())
                .then(data => {

                    if (data.status) {

                        var item = data.data.find(x => x.id == id);

                        if (item != null) {

                            $("#txtId").val(item.id);
                            $("#txtName").val(item.name);
                            $("#txtAddress").val(item.address);
                            $("#txtEmail").val(item.email);
                            $("#txtPhone").val(item.phone);

                            if (item.dob != null) {

                                $("#txtDOB").val(item.dob.substring(0, 10));

                            }

                            $("#btnSave").html('<i class="bi bi-check-circle me-1"></i>Update');

                        }

                    }

                });

        }

        function deleteData(id) {

            if (!confirm("Are you sure you want to delete this record?"))
                return;

            fetch('/api/signup/delete?id=' + id, {

                method: 'GET'

            })
                .then(response => response.json())
                .then(data => {

                    if (data.status) {

                        alert(data.message);

                        getData();

                    }
                    else {

                        alert(data.message);

                    }

                });

        }

        function clearForm() {

            $("#txtId").val("");
            $("#txtName").val("");
            $("#txtAddress").val("");
            $("#txtEmail").val("");
            $("#txtPhone").val("");
            $("#txtDOB").val("");

            $("#btnSave").html('<i class="bi bi-check-circle me-1"></i>Sign Up');

        }

    </script>

}
