@model TaskTrackerProject.Models.SignUp

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        min-height: 100vh;
    }

    .page-title {
        font-weight: 700;
        color: #fff;
        margin-bottom: 1.75rem;
        letter-spacing: 0.3px;
    }

    .page-title i {
        opacity: 0.9;
    }

    .app-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
    }

    .app-card .card-header {
        border: none;
        padding: 1.35rem 1.75rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        font-size: 1.05rem;
    }

    .card-header-gradient {
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        color: #fff;
    }

    .card-header-dark {
        background: #2c3345;
        color: #fff;
    }

    .card-body {
        padding: 2rem 1.75rem;
        background: #fff;
    }

    .form-label {
        font-weight: 600;
        color: #3a3f4b;
        margin-bottom: 0.4rem;
        font-size: 0.83rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .form-control,
    textarea.form-control {
        border-radius: 10px;
        border: 1.5px solid #e3e6f0;
        padding: 0.65rem 0.9rem;
        font-size: 0.94rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        border-color: #6a11cb;
        box-shadow: 0 0 0 0.2rem rgba(106, 17, 203, 0.15);
    }

    /* ── Professional Button Styling ── */
    .form-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eef0f4;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 0.6rem 1.6rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }

    .btn:active {
        transform: translateY(1px);
    }

    .btn-success {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: #063d1f;
        box-shadow: 0 8px 18px rgba(17, 153, 142, 0.3);
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(17, 153, 142, 0.4);
        color: #063d1f;
    }

    .btn-secondary {
        background-color: #eef0f4;
        color: #4a5568;
    }

    .btn-secondary:hover {
        background-color: #e2e5ec;
        color: #333;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        box-shadow: 0 8px 18px rgba(106, 17, 203, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(106, 17, 203, 0.4);
        opacity: 0.97;
        color: #fff;
    }

    .login-hint {
        margin-top: 1.25rem;
        font-size: 0.9rem;
        color: #6b7280;
    }

    .login-hint a {
        color: #6a11cb;
        font-weight: 700;
        text-decoration: none;
    }

    .login-hint a:hover {
        text-decoration: underline;
    }

    .table thead th {
        background-color: #f1f3f9;
        color: #2c3345;
        font-weight: 600;
        border-bottom: 2px solid #e2e5ec;
        white-space: nowrap;
    }

    .table td,
    .table th {
        vertical-align: middle;
        padding: 0.85rem 0.9rem;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fc;
    }

    .btn-action {
        border-radius: 6px;
        padding: 0.3rem 0.7rem;
        font-size: 0.85rem;
    }

    .empty-row {
        text-align: center;
        color: #888;
        padding: 2rem 0;
    }
</style>

<div class="container mt-5 mb-5">

    <h2 class="page-title"><i class="bi bi-person-lines-fill me-2"></i>User Registration</h2>

    <!-- Hidden Id -->
    <input type="hidden" id="txtId" />

    <!-- Sign Up Form -->
    <div class="card app-card">

        <div class="card-header card-header-gradient">
            <i class="bi bi-person-plus-fill me-2"></i>Sign Up
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" id="txtName" class="form-control" placeholder="Enter full name" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" id="txtEmail" class="form-control" placeholder="Enter email address" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" id="txtPassword" class="form-control" placeholder="Enter password" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" id="txtPhone" class="form-control" placeholder="Enter phone number" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Date of Birth</label>
                    <input type="date" id="txtDOB" class="form-control" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Address</label>
                    <textarea id="txtAddress" class="form-control" rows="3" placeholder="Enter address"></textarea>
                </div>

            </div>

            <div class="form-actions">

                <button id="btnSave" class="btn btn-success" onclick="saveData()">
                    <i class="bi bi-check-circle"></i>Sign Up
                </button>

                <button class="btn btn-secondary" onclick="clearForm()">
                    <i class="bi bi-x-circle"></i>Clear
                </button>

                <a href="/Home/Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i>Login
                </a>

            </div>

            <div class="login-hint">
                Already have an account? <a href="/Home/Login">Login here</a>
            </div>

        </div>

    </div>

    <!-- User list removed: displaying all registered users publicly is a privacy violation -->

</div>

@section Scripts {

    <script>

        $(document).ready(function () {
            // registration page — nothing to load on startup
        });

        function validate() {

            if ($("#txtName").val() == "") {
                alert("Name is required");
                return false;
            }

            if ($("#txtAddress").val() == "") {
                alert("Address is required");
                return false;
            }

            if ($("#txtEmail").val() == "") {
                alert("Email is required");
                return false;
            }

            if ($("#txtPhone").val() == "") {
                alert("Phone is required");
                return false;
            }
            if ($("#txtPassword").val() == "") {
                alert("Password is required");
                return false;
            }

            if ($("#txtDOB").val() == "") {
                alert("DOB is required");
                return false;
            }

            return true;
        }

        function saveData() {

            if (!validate())
                return;

            var model = {

                Name: $("#txtName").val(),
                Address: $("#txtAddress").val(),
                Email: $("#txtEmail").val(),
                Password: $("#txtPassword").val(),
                Phone: $("#txtPhone").val(),
                DOB: $("#txtDOB").val()

            };

            if ($("#txtId").val() == "") {

                // Save

                fetch('/api/signup/save', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(model)

                })
                    .then(response => response.json())
                    .then(data => {

                        if (data.status) {

                            alert("Registration Successful");

                            clearForm();

                        }
                        else {

                            alert(data.message);

                        }

                    });

            }
            else {

                // Update

                fetch('/api/signup/update', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(model)

                })
                    .then(response => response.json())
                    .then(data => {

                        if (data.status) {

                            alert(data.message);

                            clearForm();

                            getData();

                        }
                        else {

                            alert(data.message);

                        }

                    });

            }

        }

        function getData() {

            fetch('/api/signup/get', {

                method: 'GET',

                headers: {
                    'Content-Type': 'application/json'
                }

            })
                .then(response => response.json())
                .then(data => {

                    $("#tblData tbody").empty();

                    if (data.status) {

                        $.each(data.data, function (index, item) {

                            var dob = "";

                            if (item.dob != null) {

                                dob = item.dob.substring(0, 10);

                            }

                            $("#tblData tbody").append(

                                "<tr>" +
                                "<td>" + (index + 1) + "</td>" +
                                "<td>" + item.name + "</td>" +
                                "<td>" + item.address + "</td>" +
                                "<td>" + item.email + "</td>" +
                                "<td>" + item.phone + "</td>" +
                                "<td>" + dob + "</td>" +
                                "<td>" +
                                "<button class='btn btn-warning btn-sm btn-action me-1' onclick='editData(\"" + item.id + "\")'><i class=\"bi bi-pencil-square\"></i> Edit</button>" +
                                "<button class='btn btn-danger btn-sm btn-action' onclick='deleteData(\"" + item.id + "\")'><i class=\"bi bi-trash3\"></i> Delete</button>" +
                                "</td>" +
                                "</tr>"

                            );

                        });

                    }
                    else {

                        alert(data.message);

                    }

                });

        }

        function editData(id) {

            fetch('/api/signup/get')
                .then(response => response.json())
                .then(data => {

                    if (data.status) {

                        var item = data.data.find(x => x.id == id);

                        if (item != null) {

                            $("#txtId").val(item.id);
                            $("#txtName").val(item.name);
                            $("#txtAddress").val(item.address);
                            $("#txtEmail").val(item.email);
                            $("#txtPhone").val(item.phone);

                            if (item.dob != null) {

                                $("#txtDOB").val(item.dob.substring(0, 10));

                            }

                            $("#btnSave").html('<i class="bi bi-check-circle"></i>Update');

                        }

                    }

                });

        }

        function deleteData(id) {

            if (!confirm("Are you sure you want to delete this record?"))
                return;

            fetch('/api/signup/delete?id=' + id, {

                method: 'GET'

            })
                .then(response => response.json())
                .then(data => {

                    if (data.status) {

                        alert(data.message);

                        getData();

                    }
                    else {

                        alert(data.message);

                    }

                });

        }

        function clearForm() {

            $("#txtId").val("");
            $("#txtName").val("");
            $("#txtAddress").val("");
            $("#txtEmail").val("");
            $("#txtPhone").val("");
            $("#txtDOB").val("");

            $("#btnSave").html('<i class="bi bi-check-circle"></i>Sign Up');

        }

    </script>

}