@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Task Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
            :root {
                --primary: #6a11cb;
                --primary-dark: #2575fc;
                --sidebar-bg: #2c3345;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
                position: relative;
                overflow: hidden;
            }

            /* Decorative floating shapes */
            body::before,
            body::after {
                content: '';
                position: absolute;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.08);
                z-index: 0;
            }

            body::before {
                width: 380px;
                height: 380px;
                top: -120px;
                left: -120px;
            }

            body::after {
                width: 300px;
                height: 300px;
                bottom: -100px;
                right: -100px;
            }

            .login-wrapper {
                width: 100%;
                max-width: 440px;
                padding: 1rem;
                position: relative;
                z-index: 1;
            }

            .login-card {
                background: #fff;
                border-radius: 20px;
                box-shadow: 0 25px 70px rgba(0, 0, 0, 0.3);
                overflow: hidden;
            }

            .login-header {
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                padding: 2.25rem 2rem 1.75rem;
                text-align: center;
                color: #fff;
                position: relative;
            }

            .login-header .logo-icon {
                width: 60px;
                height: 60px;
                margin: 0 auto 0.75rem;
                background: rgba(255, 255, 255, 0.15);
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.7rem;
                backdrop-filter: blur(4px);
            }

            .login-header h2 {
                font-size: 1.55rem;
                font-weight: 700;
                margin-bottom: 0.25rem;
                letter-spacing: 0.3px;
            }

            .login-header p {
                font-size: 0.88rem;
                opacity: 0.85;
            }

            .login-body {
                padding: 2.25rem 2rem 2rem;
            }

            .form-label {
                font-weight: 600;
                color: #3a3f4b;
                margin-bottom: 0.4rem;
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 0.4px;
            }

            .form-control {
                border-radius: 0 10px 10px 0;
                border: 1.5px solid #e3e6f0;
                border-left: none;
                padding: 0.65rem 0.95rem;
                font-size: 0.94rem;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: none;
                outline: none;
            }

            .input-group-text {
                border-radius: 10px 0 0 10px;
                background-color: #f5f3ff;
                border: 1.5px solid #e3e6f0;
                border-right: none;
                color: var(--primary);
            }

            .input-group:focus-within .input-group-text,
            .input-group:focus-within .form-control,
            .input-group:focus-within .btn-eye {
                border-color: var(--primary);
            }

            .btn-eye {
                border-radius: 0 10px 10px 0 !important;
                border: 1.5px solid #e3e6f0;
                border-left: none;
                background: #f5f3ff;
                color: var(--primary);
                padding: 0 0.85rem;
            }

            .btn-eye:hover {
                background: #ece7ff;
            }

            .btn-login {
                width: 100%;
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                border: none;
                color: #fff;
                font-weight: 700;
                padding: 0.75rem;
                border-radius: 10px;
                font-size: 1rem;
                letter-spacing: 0.4px;
                box-shadow: 0 8px 20px rgba(106, 17, 203, 0.3);
                transition: opacity 0.2s, transform 0.15s, box-shadow 0.15s;
            }

            .btn-login:hover {
                opacity: 0.95;
                transform: translateY(-2px);
                box-shadow: 0 10px 24px rgba(106, 17, 203, 0.4);
                color: #fff;
            }

            .btn-login:active {
                transform: translateY(0);
            }

            .divider {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                margin: 1.5rem 0;
                color: #b0b4c0;
                font-size: 0.82rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .divider::before,
            .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #ececf3;
            }

            .signup-link {
                text-align: center;
                font-size: 0.9rem;
                color: #6b7280;
            }

            .signup-link a {
                color: var(--primary);
                font-weight: 700;
                text-decoration: none;
            }

            .signup-link a:hover {
                text-decoration: underline;
            }

            .alert-error {
                background: #fff1f1;
                border: 1px solid #ffc9c9;
                color: #d6336c;
                border-radius: 10px;
                padding: 0.7rem 1rem;
                font-size: 0.87rem;
                display: none;
                align-items: center;
            }

            .forgot-link {
                font-size: 0.82rem;
                color: var(--primary);
                text-decoration: none;
                float: right;
                font-weight: 500;
            }

            .forgot-link:hover {
                text-decoration: underline;
            }

            .form-check-input:checked {
                background-color: var(--primary);
                border-color: var(--primary);
            }
    </style>
</head>

<body>

    <div class="login-wrapper">
        <div class="login-card">

            <div class="login-header">
                <div class="logo-icon"><i class="bi bi-check2-square"></i></div>
                <h2>Task Tracker</h2>
                <p>Sign in to manage your tasks</p>
            </div>

            <div class="login-body">

                <div class="alert-error mb-3" id="alertError">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    <span id="errorText">Invalid email or password.</span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" id="txtEmail" class="form-control" placeholder="Enter your email" />
                    </div>
                </div>

                <div class="mb-1">
                    <label class="form-label d-flex justify-content-between align-items-center">
                        Password
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" id="txtPassword" class="form-control"
                               placeholder="Enter your password" />
                        <button class="btn btn-eye" type="button" onclick="togglePassword()">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe" style="font-size:0.9rem; color:#555;">
                            Remember me
                        </label>
                    </div>
                </div>

                <button class="btn btn-login" onclick="loginUser()">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </button>

                <div class="divider">or</div>

                <div class="signup-link">
                    Don't have an account? <a href="/">Sign up here</a>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        function togglePassword() {
        var inp = document.getElementById("txtPassword");
        var ico = document.getElementById("eyeIcon");
        inp.type = inp.type === "password" ? "text" : "password";
        ico.className = inp.type === "password" ? "bi bi-eye" : "bi bi-eye-slash";
        }

        function loginUser() {

        var email = $("#txtEmail").val().trim();
        var password = $("#txtPassword").val().trim();

        if (email == "") {
        showError("Email is required.");
        return;
        }

        if (password == "") {
        showError("Password is required.");
        return;
        }

        var model = {
        Email: email,
        Password: password
        };

        fetch('/Home/DoLogin', {

        method: 'POST',

        headers: {
        'Content-Type': 'application/json'
        },

        body: JSON.stringify(model)

        })
        .then(response => response.json())
        .then(data => {

        if (data.status) {
        window.location.href = "/Dashboard/Index";

        }
        else {

        showError(data.message);

        }

        })
        .catch(function () {

        showError("Could not connect to the server.");

        });

        }

        function showError(msg) {
        $("#errorText").text(msg);
        $("#alertError").fadeIn(200);
        }

        $(document).on('keypress', function (e) {
        if (e.which === 13) loginUser();
        });
    </script>
</body>

</html>